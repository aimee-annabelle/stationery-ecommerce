# Copy to .env and change for your machine. Never commit .env.
# docker-compose.yml already sets DATABASE_URL, TEST_DATABASE_URL and SMTP_* for local development.

ENVIRONMENT=development

# Long random string used to sign access tokens. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-dev-only-change-me-dev-only

# Set true in production (HTTPS only cookies).
COOKIE_SECURE=false

# Where the frontend runs; used for CORS and links in emails.
FRONTEND_ORIGIN=http://localhost:5173

# Email. Development sends to Mailpit (http://localhost:8025).
NOTIFIER=smtp
EMAIL_FROM=Pahyems <no-reply@pahyems.test>

# Password given to every seeded staff account (development only; the seed refuses to run in production).
SEED_STAFF_PASSWORD=pahyems-dev-2026
